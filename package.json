{
  "name": "twe-lms-backend-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "api:lint": "redocly lint docs/openapi/lms-v1.yaml",
    "api:bundle": "redocly bundle docs/openapi/lms-v1.yaml --output packages/api-client/openapi.json",
    "api:types": "openapi-typescript docs/openapi/lms-v1.yaml -o src/generated/api/schema.d.ts && openapi-typescript docs/openapi/lms-v1.yaml -o packages/api-client/src/schema.ts",
    "api:client": "pnpm api:types && pnpm api:bundle && pnpm --dir packages/api-client build",
    "api:pack": "pnpm api:client && pnpm --dir packages/api-client pack",
    "api:check": "pnpm api:lint && pnpm api:client && git diff --exit-code -- src/generated/api/schema.d.ts packages/api-client/src/schema.ts packages/api-client/openapi.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:financial-acceptance": "node --experimental-strip-types scripts/friday-financial-acceptance.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm db:validate && pnpm api:check && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@tabler/icons-react": "^3.26.0",
    "@tanstack/react-table": "^8.20.6",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^2.30.0",
    "dotenv": "17.4.2",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.3.0",
    "@redocly/cli": "^2.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
